{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with casino balance, affiliate stats, cpf, and daily spin data.",
      "type": "object",
      "properties": {
        "cpf": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "passwordHash": { "type": "string", "maxLength": 256 },
        "balance": { "type": "number" },
        "balanceBonus": { "type": "number" },
        "termsAccepted": { "type": "boolean" },
        "referralCode": { "type": "string", "maxLength": 32 },
        "affiliateEarnings": { "type": "number" },
        "invitedCount": { "type": "number" },
        "lastDailySpin": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cpf", "name", "balance"]
    },
    "Bet": {
      "title": "Bet",
      "description": "Sports betting coupon placed by user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "stake": { "type": "number" },
        "totalOdds": { "type": "number" },
        "possibleReturn": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "WON", "LOST"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "stake", "totalOdds", "status"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial logs for deposits, withdrawals, and game wins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["DEPOSIT", "WITHDRAWAL", "SPIN_WIN", "BET_WIN", "BET_PLACE"] },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["COMPLETED", "PENDING"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "amount", "status"]
    },
    "DepositRequest": {
      "title": "DepositRequest",
      "description": "Moderated PIX deposit request with manual admin confirmation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "transactionId": { "type": "string", "maxLength": 128 },
        "cpf": { "type": "string", "maxLength": 32 },
        "clientName": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "bonusAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["WAITING_PAYMENT", "PAID_PENDING_APPROVAL", "APPROVED", "REJECTED"] },
        "gatewayStatus": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "approvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "amount", "status"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Global casino settings including maintenance mode and alerts.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string", "maxLength": 512 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["maintenanceMode"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document identified by CPF."
    },
    "/users/{userId}/bets/{betId}": {
      "schema": { "$ref": "#/entities/Bet" },
      "description": "Subcollection of bets placed by the user."
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Subcollection of user transaction history."
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/DepositRequest" },
      "description": "Moderated deposits queue for admin approval."
    },
    "/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSetting" },
      "description": "Global system configuration document."
    }
  }
}
