rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents indexed by CPF or telephone key
    match /users/{userId} {
      // Allow user profile access and admin listing
      allow get, list, read: if true;
      allow create, update: if true;
      allow delete: if true;

      // User bets subcollection
      match /bets/{betId} {
        allow read, write: if true;
      }

      // User transactions subcollection
      match /transactions/{txId} {
        allow read, write: if true;
      }
    }

    // Deposits Queue
    match /deposits/{depositId} {
      allow get, list, read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Global System Settings (e.g. Maintenance Mode)
    match /system_settings/{settingId} {
      allow get, list, read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
