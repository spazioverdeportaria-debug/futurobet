rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents indexed by CPF or telephone key
    match /users/{userId} {
      // Allow individual user lookup by ID; prevent public bulk listing
      allow get: if isValidId(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0;
      allow update: if isValidId(userId)
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0;
      allow delete: if false;

      // User bets subcollection
      match /bets/{betId} {
        allow read, write: if isValidId(userId);
      }

      // User transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isValidId(userId);
      }
    }

    // Deposits Queue
    match /deposits/{depositId} {
      allow get: if isValidId(depositId);
      allow list: if false;
      allow create: if isValidId(depositId)
        && request.resource.data.amount is number
        && request.resource.data.amount >= 5;
      allow update: if isValidId(depositId);
      allow delete: if false;
    }

    // Global System Settings (e.g. Maintenance Mode)
    match /system_settings/{settingId} {
      allow get, list: if isValidId(settingId);
      allow create, update: if isValidId(settingId);
      allow delete: if false;
    }
  }
}
