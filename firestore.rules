rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.cpf is string && data.cpf.size() <= 32 &&
             data.name is string && data.name.size() <= 128 &&
             data.balance is number && data.balance >= 0;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profile documents indexed by CPF
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if false;

      // User bets subcollection
      match /bets/{betId} {
        allow read, write: if isValidId(userId) && isValidId(betId);
      }

      // User transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isValidId(userId) && isValidId(txId);
      }
    }
  }
}
