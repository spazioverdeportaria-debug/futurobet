rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profile documents indexed by CPF
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update: if isValidId(userId);
      allow delete: if false;

      // User bets subcollection
      match /bets/{betId} {
        allow read, write: if isValidId(userId);
      }

      // User transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isValidId(userId);
      }
    }

    // Global Deposits Queue for Admin approval and User Realtime Tracking
    match /deposits/{depositId} {
      allow get: if isValidId(depositId);
      allow list: if true;
      allow create, update, delete: if isValidId(depositId);
    }

    // Global System Settings (e.g. Maintenance Mode)
    match /system_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId);
    }
  }
}
